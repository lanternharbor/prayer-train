generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models (NextAuth) ─────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  // PrayerTrain relations
  organizedTrains PrayerTrain[]   @relation("Organizer")
  claimedSlots    PrayerSlot[]    @relation("ClaimedBy")
  guestbookEntries GuestbookEntry[]
  trainUpdates    TrainUpdate[]

  // PrayerChain relations
  organizedChains   PrayerChain[]        @relation("ChainOrganizer")
  chainMemberships  PrayerChainMember[]

  // PrayerWarrior pledges — soft-pledge to pray for a train without
  // taking a calendar slot. See PrayerWarrior model below.
  warriorPledges    PrayerWarrior[]      @relation("WarriorPledges")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── PrayerTrain Core ───────────────────────────────────────────

enum SituationCategory {
  ILLNESS
  SURGERY
  MENTAL_HEALTH
  GRIEF
  PREGNANCY
  FERTILITY
  MARRIAGE
  FAMILY
  FINANCIAL
  CAREER
  CONVERSION
  DISCERNMENT
  GENERAL
  OTHER
}

enum TrainStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SlotStatus {
  OPEN
  CLAIMED
  COMPLETED
}

enum PrayerCategory {
  NOVENA
  ROSARY
  CHAPLET
  LITANY
  SHORT_PRAYER
  MASS_SACRAMENTAL
  SCRIPTURE
  DEVOTION
  ALL_CHRISTIANS
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model PrayerTrain {
  id          String   @id @default(cuid())
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Organizer
  organizerId String
  organizer   User     @relation("Organizer", fields: [organizerId], references: [id])

  // Recipient info
  recipientName     String
  recipientRelation String?
  recipientImageUrl String?
  parish            String?
  parishId          String?
  parishRef         Parish?  @relation(fields: [parishId], references: [id])
  location          String?
  intention         String   @db.Text
  situation         SituationCategory
  situationDetail   String?  @db.Text

  // Train config
  startDate   DateTime
  endDate     DateTime
  slotsPerDay Int       @default(3)
  status      TrainStatus @default(ACTIVE)

  // Optional personal prayer the organizer wants every volunteer to also
  // pray, alongside the prayer-type text from the library. Renders as its
  // own card on the detail page and gets appended to the daily reminder
  // emails. Free-form text — frequently a prayer a friend wrote, a family
  // tradition, or words from the organizer's heart.
  customPrayerText String? @db.Text

  // Privacy
  isPublic    Boolean  @default(false)
  showNames   Boolean  @default(true)

  // Relations
  slots       PrayerSlot[]
  guestbook   GuestbookEntry[]
  updates     TrainUpdate[]
  warriors    PrayerWarrior[]

  @@index([slug])
  @@index([organizerId])
  // Composite index: speeds up the public browse/sitemap query that
  // filters by isPublic and orders by updatedAt or status.
  @@index([isPublic, status])
}

model PrayerType {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    PrayerCategory
  description String   @db.Text
  instructions String? @db.Text
  prayerText  String?  @db.Text
  duration    Int      // minutes
  difficulty  DifficultyLevel
  daysRequired Int     @default(1) // 9 for novenas, 1 for most
  patronSaint String?
  feastDay    String?
  situationTags SituationCategory[]
  imageUrl    String?
  sourceUrl   String?
  createdAt   DateTime @default(now())

  // Relations
  slots       PrayerSlot[]
  chains      PrayerChain[]

  @@index([category])
  @@index([slug])
}

model PrayerSlot {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Which train and day
  trainId     String
  train       PrayerTrain @relation(fields: [trainId], references: [id], onDelete: Cascade)
  date        DateTime
  slotIndex   Int        // 0, 1, 2 for 3 slots/day

  // What prayer
  prayerTypeId String
  prayerType   PrayerType @relation(fields: [prayerTypeId], references: [id])

  // Who claimed it
  status      SlotStatus @default(OPEN)
  claimedById String?
  claimedBy   User?      @relation("ClaimedBy", fields: [claimedById], references: [id])
  claimedAt   DateTime?
  claimerName String?    // for non-auth users
  claimerEmail String?   // for non-auth users
  completedAt DateTime?

  // Novena grouping — all slots in a novena share the same groupId
  novenaGroupId String?

  @@unique([trainId, date, slotIndex])
  @@index([trainId])
  @@index([claimedById])
  @@index([novenaGroupId])
  // Composite index: speeds up the daily-reminders cron, which filters
  // by today's date AND CLAIMED status in a single query.
  @@index([date, status])
  // Composite index: speeds up the novena-claim lookup that filters by
  // trainId + prayerTypeId + slotIndex + status (next 9 open slots in
  // the same series).
  @@index([trainId, prayerTypeId, slotIndex, status])
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  trainId   String
  train     PrayerTrain @relation(fields: [trainId], references: [id], onDelete: Cascade)

  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  authorName String  // displayed name (works for non-auth too)
  message   String   @db.Text

  @@index([trainId])
}

model TrainUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  trainId   String
  train     PrayerTrain @relation(fields: [trainId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  content   String   @db.Text

  @@index([trainId])
}

// ─── PrayerWarrior — overflow primitive ─────────────────────────
// A lightweight pledge for someone who wants to pray for the recipient
// but isn't claiming a specific calendar slot — surfaced as the primary
// CTA on the train detail page when every slot is already claimed
// ("Every slot is filled — and you can still join"). The slot-based
// train remains the organizing mechanism; warriors are the "no one is
// turned away from praying" affordance. Mirrors PrayerChainMember's
// shape (name + email minimum, optional User link, idempotent on
// (trainId, email)).

model PrayerWarrior {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())

  trainId   String
  train     PrayerTrain @relation(fields: [trainId], references: [id], onDelete: Cascade)

  // Joiner identity. Account is optional — name + email is the minimum,
  // matching PrayerSlot.claimerName/claimerEmail and PrayerChainMember.
  userId    String?
  user      User?       @relation("WarriorPledges", fields: [userId], references: [id])
  name      String
  email     String

  // Optional brief intention shown alongside their name on the roster.
  message   String?     @db.Text

  // One pledge per email per train. Re-submitting with the same email
  // updates name/message rather than creating duplicates.
  @@unique([trainId, email])
  @@index([trainId])
}

// ─── PrayerChain (synchronized solidarity) ──────────────────────
// A second prayer primitive alongside PrayerTrain. Same prayer, same days,
// group of people praying together — the "I'm doing this novena, want to
// join me?" pattern. Fully isolated from PrayerTrain code paths: separate
// tables, separate routes, separate cron handler. See docs/chains-spec.md
// for the full design rationale.

enum ChainStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  PROMOTED   // converted into a Train via the future Promote-to-Train flow
}

model PrayerChain {
  id                String       @id @default(cuid())
  slug              String       @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Organizer
  organizerId       String
  organizer         User         @relation("ChainOrganizer", fields: [organizerId], references: [id])

  // Which prayer the chain prays
  prayerTypeId      String
  prayerType        PrayerType   @relation(fields: [prayerTypeId], references: [id])

  // Recipient + intention (one-line free text — no situation taxonomy needed
  // for chains; intention text carries the meaning)
  recipientName     String?
  recipientImageUrl String?      // optional Vercel Blob URL — same shape as PrayerTrain
  intention         String       @db.Text

  // Optional personal prayer the organizer wants every member to also pray,
  // alongside the prayer-type text from the library. Renders as its own card
  // on the chain detail page and gets appended to the daily reminder emails.
  // Mirrors PrayerTrain.customPrayerText.
  customPrayerText  String?      @db.Text

  // Schedule
  startDate         DateTime
  durationDays      Int
  endDate           DateTime

  // Visibility
  isPublic          Boolean      @default(false)

  // State
  status            ChainStatus  @default(ACTIVE)
  closingNote       String?      @db.Text

  // Future Phase D: link to a PrayerTrain that this chain was promoted into.
  // Soft reference (no FK) so promote-to-train can ship later without a
  // schema change.
  promotedToTrainId String?

  // Relations
  members           PrayerChainMember[]

  @@index([organizerId])
  @@index([prayerTypeId])
  // Composite index speeds up the public browse query (filter by isPublic
  // + ACTIVE status) and the chain-reminders cron (filter by ACTIVE).
  @@index([status, isPublic])
}

model PrayerChainMember {
  id               String       @id @default(cuid())
  chainId          String
  chain            PrayerChain  @relation(fields: [chainId], references: [id], onDelete: Cascade)

  // Joiner identity. Account is optional — name + email is the minimum,
  // matching the PrayerSlot claim pattern.
  userId           String?
  user             User?        @relation(fields: [userId], references: [id])
  name             String
  email            String

  // Optional daily-completion tracking. 1-indexed; null until the member
  // marks anything. Idempotent updates via max(current, day).
  lastDayCompleted Int?

  joinedAt         DateTime     @default(now())
  // Soft leave — they stop receiving reminders but stay in the roster
  // and on the spiritual bouquet.
  unsubscribedAt   DateTime?

  // One membership per email per chain.
  @@unique([chainId, email])
  @@index([chainId])
  @@index([email])
}

// ─── Parish Directory ───────────────────────────────────────

model Parish {
  id        String   @id @default(cuid())
  name      String
  city      String
  state     String
  diocese   String?
  country   String   @default("US")
  createdAt DateTime @default(now())

  // Relations
  trains    PrayerTrain[]

  @@unique([name, city, state])
  @@index([name])
  @@index([city, state])
}
